# Copy to .env.local and fill in. Never commit real keys.

# --- Supabase (auth + database) ---
# Create a project at https://supabase.com, then Project Settings -> API.
# Newer projects issue publishable/secret keys; the legacy anon/service_role
# names still work (the code accepts either). Apply the schema in supabase/
# first — see supabase/README.md.
NEXT_PUBLIC_SUPABASE_URL=
# Public, ships to the browser; data is protected by Row-Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS — never expose to the browser. Needed by the server
# data-access layer (src/lib/server/db). Legacy name: SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# --- AI (server-side; any ONE provider is enough; free tiers listed first) ---
# Groq free tier:   https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Google Gemini free tier:  https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Anthropic (optional, paid):  https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Optional: force a provider — groq | gemini | anthropic
AI_PROVIDER=

# --- Trends ---
# Optional operator-supplied feed: your own compliant social crawler or a paid
# trends API. Must return a JSON array (or { "trends": [...] }) of objects like
# { "title": "...", "url": "...", "platform": "TikTok" }.
CUSTOM_TRENDS_URL=
