# Copy to .env.local and fill in. Never commit real keys.

# --- Supabase (auth + database) — REQUIRED ---
# The app is account-only: without these it cannot sign anyone in or store
# anything, and /sign-in says so. Create a project at https://supabase.com,
# then Project Settings -> API. Run supabase/migrations/ against it before use.
#
# Enable the sign-in methods the app offers, in Authentication -> Providers:
#   Email (magic link)  and  Google (needs a Google Cloud OAuth client).
# Add <your-origin>/auth/callback to the allowed redirect URLs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (server-side; any ONE provider is enough; free tiers listed first) ---
# Groq free tier:   https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Google Gemini free tier:  https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Anthropic (optional, paid):  https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Optional: force a provider — groq | gemini | anthropic
AI_PROVIDER=

# --- Supabase database password (local tooling / direct psql only) ---
# Leave blank here. This file is COMMITTED — only ever put empty placeholders in
# it. Real values belong in .env.local (git-ignored) or the Vercel dashboard.
SUPABASE_PASSWORD=
