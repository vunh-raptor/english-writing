# Copy to .env.local and fill in. Never commit real keys.

# --- Supabase (auth + database) — REQUIRED ---
# The app is account-only: without these it cannot sign anyone in or store
# anything, and /sign-in says so. Create a project at https://supabase.com,
# then Project Settings -> API. Run supabase/migrations/ against it before use.
#
# Newer projects issue publishable/secret keys; older ones issue anon/service_role.
# The code reads the new names first and falls back to the legacy ones, so either
# key system works — set one name per pair, and prefer the new one.
#
# Enable the sign-in methods the app offers, in Authentication -> Providers:
#   Email (magic link)  and  Google (needs a Google Cloud OAuth client).
# Add <your-origin>/auth/callback to the allowed redirect URLs.
NEXT_PUBLIC_SUPABASE_URL=
# Public, ships to the browser; Row-Level Security is what protects the data, not
# key secrecy. Legacy name: NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS — never expose to the browser. Needed by the server
# data-access layer (src/lib/server/db). Legacy name: SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# --- AI (server-side; any ONE provider is enough; free tiers listed first) ---
# Groq free tier:   https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Google Gemini free tier:  https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Anthropic (optional, paid):  https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Optional: force a provider — groq | gemini | anthropic
AI_PROVIDER=

# The app reads nothing else. In particular it never needs the Postgres password:
# that belongs to the Supabase CLI (SUPABASE_DB_PASSWORD, for non-interactive
# `supabase db push`), which does not read this file — see supabase/README.md.
